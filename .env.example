# ==============================================================================
# Arizona Sound System. Environment
# ==============================================================================
# Copy to .env.local for local development, and set the same names in the
# Amplify console (App settings, Environment variables) for the deployed app.
#
# With NONE of these set, `npm run dev` still works: inquiries are written to
# .data/inquiries.json and no email is sent.
# ==============================================================================

# --- Data (from the CloudFormation stack outputs) -----------------------------
# SUBMISSIONS_TABLE=azsoundsystem-submissions
# RATELIMIT_TABLE=azsoundsystem-ratelimit

# Amplify blocks variables starting with AWS_, so set the region here.
# In Lambda, AWS_REGION is injected automatically and used as a fallback.
# APP_AWS_REGION=us-west-1

# --- Email (Amazon SES) -------------------------------------------------------
# With none of these set, no email is sent and inquiries are still recorded.
#
# Sender. Must be an address on the SES-verified domain. Setting this alone
# enables email; the display name is optional.
# SES_FROM_ADDRESS="Arizona Sound System <hello@azsoundsystem.com>"

# Where replies to the acknowledgement go. Defaults to contact.email.
# SES_REPLY_TO=hello@azsoundsystem.com

# Who gets the inquiry. Comma separated. Defaults to notifications.inquiry in
# content/site.ts. Set to an empty string to alert nobody.
# INQUIRY_NOTIFY_ADDRESS=hello@azsoundsystem.com

# From the stack output EmailConfigurationSetName. Enables bounce/complaint
# suppression and reputation metrics.
# SES_CONFIGURATION_SET=azsoundsystem-email

# Absolute base URL used for links and the logo inside emails. Defaults to
# brand.domain.
# SITE_URL=https://azsoundsystem.com
